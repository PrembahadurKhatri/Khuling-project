# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/khilung-kalika

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_REFRESH_EXPIRE=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (SendGrid HTTP API — see server/utils/sendEmail.js)
# Most hosts (Render included) block outbound raw SMTP ports to prevent
# spam abuse, so plain nodemailer/Gmail SMTP silently times out in
# production no matter how correct the credentials are. Sending over HTTPS
# instead sidesteps that entirely. Get a key at https://app.sendgrid.com
# (Settings -> API Keys), and verify your From address under Settings ->
# Sender Authentication -> Single Sender Verification (no owned domain
# required — verifying a plain Gmail-type address is enough).
SENDGRID_API_KEY=your_sendgrid_api_key
# EMAIL_FROM's address MUST be the exact address you verified as a Single
# Sender above — SendGrid rejects sends from an unverified From address.
EMAIL_FROM="Khilung Kalika Construction <your_verified_sender@example.com>"
