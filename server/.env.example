# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/khilung-kalika

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_REFRESH_EXPIRE=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
# EMAIL_FROM's domain MUST match SMTP_USER's domain (or a domain you've set up
# SPF/DKIM for) — e.g. if SMTP_USER is a @gmail.com address, EMAIL_FROM should
# be that same address, not a custom domain you don't control. Gmail's SMTP
# relay will happily accept a send with a mismatched From (no error!), but
# receiving mail servers see a from-domain that doesn't authorize Gmail's
# servers to send on its behalf and silently spam-bin or drop the message —
# it "sends" successfully but nobody ever receives it.
EMAIL_FROM="Khilung Kalika Construction <your_email@gmail.com>"
